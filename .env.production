# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=BoofHichKa$
DEBUG=False

ALLOWED_HOSTS=lonamarket.com,www.lonamarket.com
CSRF_TRUSTED_ORIGINS=https://lonamarket.com,https://www.lonamarket.com


# Database (PostgreSQL)
DATABASE_URL=postgres://shopcms:strong-password@db:5432/shopcms
POSTGRES_PASSWORD=strong-password

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
RATE_LIMIT_ENABLED=True

# Static & Media
STATIC_URL=/static/
MEDIA_URL=/media/

# Logging & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
PLATFORM_NAME=ShopCMS

# Multi-tenant
DEFAULT_STORE_SLUG=shop1

# Auth OTP (production - disable fixed code)
OTP_USE_FIXED_CODE=False

# Backups
BACKUP_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
