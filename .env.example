# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite for local; for Docker/Postgres use:
# DATABASE_URL=postgres://shopcms:shopcms@localhost:5432/shopcms
DATABASE_URL=sqlite:///db.sqlite3

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Static & Media
STATIC_URL=/static/
MEDIA_URL=/media/

# Logging
LOG_LEVEL=INFO

# Multi-tenant
DEFAULT_STORE_SLUG=shop1

# Auth OTP (development)
OTP_USE_FIXED_CODE=True
OTP_FIXED_CODE=12345

# CORS (for future frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
